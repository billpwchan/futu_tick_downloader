# ===== Futu OpenD 連線 =====
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_SYMBOLS=HK.00700,HK.00981

# ===== 資料落地 =====
DATA_ROOT=/data/sqlite/HK
BATCH_SIZE=500
MAX_WAIT_MS=1000
MAX_QUEUE_SIZE=20000

# ===== Poll 備援 =====
FUTU_POLL_ENABLED=1
FUTU_POLL_INTERVAL_SEC=3
FUTU_POLL_NUM=100
FUTU_POLL_STALE_SEC=10
FUTU_POLL_TRADING_ONLY=1
FUTU_POLL_PREOPEN_ENABLED=0
FUTU_POLL_OFFHOURS_PROBE_INTERVAL_SEC=0
FUTU_POLL_OFFHOURS_PROBE_NUM=1
FUTU_HOLIDAYS=
FUTU_HOLIDAY_FILE=

# ===== Watchdog =====
WATCHDOG_STALL_SEC=180
WATCHDOG_UPSTREAM_WINDOW_SEC=60
WATCHDOG_QUEUE_THRESHOLD_ROWS=100
WATCHDOG_RECOVERY_MAX_FAILURES=3
WATCHDOG_RECOVERY_JOIN_TIMEOUT_SEC=3

# ===== SQLite =====
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_WAL_AUTOCHECKPOINT=1000

# ===== 資料品質（Gap / Report）=====
GAP_ENABLED=1
GAP_THRESHOLD_SEC=10
GAP_ACTIVE_WINDOW_SEC=300
GAP_ACTIVE_MIN_TICKS=50
GAP_STALL_WARN_SEC=30
TRADING_TZ=Asia/Hong_Kong
TRADING_SESSIONS=09:30-12:00,13:00-16:00

# ===== Telegram（可選） =====
TG_ENABLED=0
TG_TOKEN=
TG_CHAT_ID=
TG_MESSAGE_THREAD_ID=
TG_THREAD_HEALTH_ID=
TG_THREAD_OPS_ID=
TG_MODE_DEFAULT=product
TG_PARSE_MODE=HTML
# 固定心跳間隔（秒）；>0 時會覆蓋盤前/盤中/盤後節奏，建議 600（每 10 分鐘）
HEALTH_FIXED_INTERVAL_SEC=
HEALTH_INTERVAL_SEC=900
HEALTH_TRADING_INTERVAL_SEC=900
HEALTH_OFFHOURS_INTERVAL_SEC=1800
TG_HEALTH_LUNCH_ONCE=1
TG_HEALTH_AFTER_CLOSE_ONCE=1
TG_HEALTH_HOLIDAY_MODE=daily
TG_INCLUDE_SYSTEM_METRICS=1
ALERT_COOLDOWN_SEC=600
TG_RATE_LIMIT_PER_MIN=18
TG_INTERACTIVE_ENABLED=0
TG_ADMIN_USER_IDS=
TG_ACTION_CONTEXT_TTL_SEC=43200
TG_ACTION_LOG_MAX_LINES=20
TG_ACTION_REFRESH_MIN_INTERVAL_SEC=15
TG_ACTION_COMMAND_RATE_LIMIT_PER_MIN=8
TG_ACTION_TIMEOUT_SEC=3.0
TG_ACTION_COMMAND_TIMEOUT_SEC=10.0
TG_ACTION_COMMAND_ALLOWLIST=help,db_stats,top_symbols,symbol
TG_ACTION_COMMAND_MAX_LOOKBACK_DAYS=30

# ===== 其他 =====
DRIFT_WARN_SEC=120
LOG_LEVEL=INFO
INSTANCE_ID=lightsail-hk-a1

# ===== 主機資源監控 =====
# 補上採集管線看不到的那一維：2026-08-17 事故中 collector 全程健康，
# 主機卻因 CPU 額度耗盡被 hypervisor 限流，既有健康檢查全部回報正常。
HOST_MONITOR_ENABLED=1
# 此機型「可持續」CPU 佔比（佔整台機器）。burstable 機型只有在低於此值時
# 才累積額度。無法從 guest 內部讀取，必須依 AWS 對該方案公布的值填寫。
HOST_CPU_BASELINE_PCT=20
# 高於基線多久才告警。這段等待就是提前量的來源：短暫突波是正常行為。
HOST_CPU_BURN_SUSTAIN_SEC=1200
# steal 是「已被限流」的確認訊號，不是預警訊號（額度此時已耗盡）。
HOST_CPU_STEAL_ALERT_PCT=15
HOST_DISK_WARN_PCT=80
HOST_DISK_ALERT_PCT=90
HOST_DISK_PATH=/
HOST_MEM_PRESSURE_FULL_AVG60=5
# swap 換頁速率（pages/s）。用速率而非佔用量：事故遺留的冷 swap 不代表壓力。
HOST_SWAP_PAGES_PER_SEC_WARN=200

# Futu SDK 自身的日誌級別。SDK 硬編碼為 DEBUG 且 propagate=False，
# LOG_LEVEL 管不到它；每筆 tick push 兩行，實測約 55MB/小時。
# 需要除錯 SDK 傳輸層時改回 DEBUG。
FUTU_SDK_LOG_LEVEL=WARNING
